generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CommonStatus {
  active
  inactive
  disabled
  archived
}

enum TenantStatus {
  pending_review
  active
  rejected
  disabled
  overdue
  expired
}

enum SubscriptionStatus {
  active
  trialing
  expired
  cancelled
  past_due
}

enum OrderStatus {
  pending
  paid
  cancelled
  refunded
  failed
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

enum TaskStatus {
  pending
  running
  succeeded
  failed
  cancelled
}

enum WebhookDeliveryStatus {
  pending
  succeeded
  failed
}

model App {
  id            String       @id @default(cuid())
  name          String
  appKey        String       @unique @map("app_key")
  appType       String       @map("app_type")
  domain        String?
  status        CommonStatus @default(active)
  defaultPlanId String?      @map("default_plan_id")
  config        Json?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("apps")
}

model Tenant {
  id                 String       @id @default(cuid())
  appId              String       @map("app_id")
  name               String
  tenantType         String?      @map("tenant_type")
  contactName        String?      @map("contact_name")
  phone              String?
  email              String?
  industry           String?
  region             String?
  status             TenantStatus @default(pending_review)
  currentPlanId      String?      @map("current_plan_id")
  subscriptionStatus String?      @map("subscription_status")
  expiredAt          DateTime?    @map("expired_at")
  source             String?
  remark             String?
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  deletedAt          DateTime?    @map("deleted_at")

  @@index([appId])
  @@index([status])
  @@map("tenants")
}

model User {
  id           String       @id @default(cuid())
  phone        String?      @unique
  email        String?      @unique
  passwordHash String       @map("password_hash")
  displayName  String?      @map("display_name")
  avatarUrl    String?      @map("avatar_url")
  status       CommonStatus @default(active)
  lastLoginAt  DateTime?    @map("last_login_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  @@map("users")
}

model TenantMembership {
  id        String       @id @default(cuid())
  appId     String       @map("app_id")
  tenantId  String?      @map("tenant_id")
  userId    String       @map("user_id")
  roleId    String       @map("role_id")
  status    CommonStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@unique([appId, tenantId, userId, roleId])
  @@index([userId])
  @@index([tenantId])
  @@map("tenant_memberships")
}

model Role {
  id          String       @id @default(cuid())
  appId       String?      @map("app_id")
  tenantId    String?      @map("tenant_id")
  roleKey     String       @map("role_key")
  name        String
  description String?
  dataScope   String       @default("tenant") @map("data_scope")
  isBuiltin   Boolean      @default(false) @map("is_builtin")
  status      CommonStatus @default(active)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@unique([appId, tenantId, roleKey])
  @@map("roles")
}

model Permission {
  id            String       @id @default(cuid())
  permissionKey String       @unique @map("permission_key")
  name          String
  module        String
  action        String
  description   String?
  status        CommonStatus @default(active)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Menu {
  id            String       @id @default(cuid())
  parentId      String?      @map("parent_id")
  menuKey       String       @unique @map("menu_key")
  title         String
  path          String?
  icon          String?
  sortOrder     Int          @default(0) @map("sort_order")
  permissionKey String?      @map("permission_key")
  status        CommonStatus @default(active)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("menus")
}

model RoleMenu {
  id        String   @id @default(cuid())
  roleId    String   @map("role_id")
  menuId    String   @map("menu_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([roleId, menuId])
  @@map("role_menus")
}

model Feature {
  id          String       @id @default(cuid())
  featureKey  String       @unique @map("feature_key")
  name        String
  module      String
  description String?
  isMetered   Boolean      @default(false) @map("is_metered")
  status      CommonStatus @default(active)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("features")
}

model Plan {
  id            String       @id @default(cuid())
  appId         String       @map("app_id")
  name          String
  description   String?
  priceMonthly  Decimal      @default(0) @map("price_monthly") @db.Decimal(12, 2)
  priceYearly   Decimal      @default(0) @map("price_yearly") @db.Decimal(12, 2)
  status        CommonStatus @default(active)
  isPublic      Boolean      @default(true) @map("is_public")
  isRecommended Boolean      @default(false) @map("is_recommended")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([appId])
  @@map("plans")
}

model PlanFeature {
  id         String   @id @default(cuid())
  planId     String   @map("plan_id")
  featureId  String   @map("feature_id")
  enabled    Boolean  @default(true)
  quotaType  String?  @map("quota_type")
  quotaLimit Int?     @map("quota_limit")
  resetCycle String?  @map("reset_cycle")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([planId, featureId])
  @@map("plan_features")
}

model Subscription {
  id        String             @id @default(cuid())
  appId     String             @map("app_id")
  tenantId  String             @map("tenant_id")
  planId    String             @map("plan_id")
  status    SubscriptionStatus @default(active)
  startAt   DateTime           @map("start_at")
  endAt     DateTime           @map("end_at")
  autoRenew Boolean            @default(false) @map("auto_renew")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@index([appId, tenantId])
  @@map("subscriptions")
}

model Order {
  id        String      @id @default(cuid())
  appId     String      @map("app_id")
  tenantId  String      @map("tenant_id")
  planId    String?     @map("plan_id")
  orderNo   String      @unique @map("order_no")
  amount    Decimal     @db.Decimal(12, 2)
  currency  String      @default("CNY")
  status    OrderStatus @default(pending)
  paidAt    DateTime?   @map("paid_at")
  createdBy String?     @map("created_by")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([appId, tenantId])
  @@map("orders")
}

model PaymentTransaction {
  id              String        @id @default(cuid())
  appId           String        @map("app_id")
  tenantId        String        @map("tenant_id")
  orderId         String        @map("order_id")
  provider        String
  providerTradeNo String?       @map("provider_trade_no")
  amount          Decimal       @db.Decimal(12, 2)
  status          PaymentStatus @default(pending)
  rawPayload      Json?         @map("raw_payload")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("payment_transactions")
}

model UsageLedger {
  id           String   @id @default(cuid())
  appId        String   @map("app_id")
  tenantId     String   @map("tenant_id")
  featureKey   String   @map("feature_key")
  metric       String
  quantity     Int
  sourceType   String?  @map("source_type")
  sourceId     String?  @map("source_id")
  costAmount   Decimal? @map("cost_amount") @db.Decimal(12, 6)
  chargeAmount Decimal? @map("charge_amount") @db.Decimal(12, 6)
  occurredAt   DateTime @default(now()) @map("occurred_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([appId, tenantId, featureKey, occurredAt])
  @@map("usage_ledger")
}

model QuotaBucket {
  id          String   @id @default(cuid())
  appId       String   @map("app_id")
  tenantId    String   @map("tenant_id")
  featureKey  String   @map("feature_key")
  metric      String
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  limit       Int
  used        Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, featureKey, metric, periodStart, periodEnd])
  @@map("quota_buckets")
}

model AiProvider {
  id          String       @id @default(cuid())
  providerKey String       @unique @map("provider_key")
  name        String
  baseUrl     String?      @map("base_url")
  secretRef   String?      @map("secret_ref")
  status      CommonStatus @default(active)
  config      Json?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("ai_providers")
}

model AiModel {
  id               String       @id @default(cuid())
  providerId       String       @map("provider_id")
  modelKey         String       @map("model_key")
  name             String
  modality         String       @default("text")
  inputTokenPrice  Decimal?     @map("input_token_price") @db.Decimal(12, 8)
  outputTokenPrice Decimal?     @map("output_token_price") @db.Decimal(12, 8)
  status           CommonStatus @default(active)
  config           Json?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@unique([providerId, modelKey])
  @@map("ai_models")
}

model AiModelRoute {
  id              String       @id @default(cuid())
  appId           String?      @map("app_id")
  tenantId        String?      @map("tenant_id")
  routeKey        String       @map("route_key")
  primaryModelId  String       @map("primary_model_id")
  fallbackModelId String?      @map("fallback_model_id")
  status          CommonStatus @default(active)
  config          Json?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@unique([appId, tenantId, routeKey])
  @@map("ai_model_routes")
}

model Prompt {
  id             String       @id @default(cuid())
  appId          String?      @map("app_id")
  tenantId       String?      @map("tenant_id")
  promptKey      String       @map("prompt_key")
  name           String
  description    String?
  currentVersion Int?         @map("current_version")
  status         CommonStatus @default(active)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([appId, tenantId, promptKey])
  @@map("prompts")
}

model PromptVersion {
  id        String   @id @default(cuid())
  promptId  String   @map("prompt_id")
  version   Int
  content   String
  variables Json?
  status    String   @default("draft")
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([promptId, version])
  @@map("prompt_versions")
}

model PromptTestRun {
  id              String   @id @default(cuid())
  promptId        String   @map("prompt_id")
  promptVersionId String?  @map("prompt_version_id")
  input           Json?
  output          Json?
  latencyMs       Int?     @map("latency_ms")
  errorMessage    String?  @map("error_message")
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("prompt_test_runs")
}

model AiCallLog {
  id             String   @id @default(cuid())
  appId          String   @map("app_id")
  tenantId       String?  @map("tenant_id")
  userId         String?  @map("user_id")
  providerKey    String?  @map("provider_key")
  modelKey       String?  @map("model_key")
  routeKey       String?  @map("route_key")
  promptKey      String?  @map("prompt_key")
  requestTokens  Int?     @map("request_tokens")
  responseTokens Int?     @map("response_tokens")
  totalTokens    Int?     @map("total_tokens")
  costAmount     Decimal? @map("cost_amount") @db.Decimal(12, 6)
  latencyMs      Int?     @map("latency_ms")
  status         String
  errorMessage   String?  @map("error_message")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([appId, tenantId, createdAt])
  @@map("ai_call_logs")
}

model FileAsset {
  id        String       @id @default(cuid())
  appId     String       @map("app_id")
  tenantId  String?      @map("tenant_id")
  bucket    String
  objectKey String       @map("object_key")
  fileName  String       @map("file_name")
  mimeType  String?      @map("mime_type")
  sizeBytes Int          @map("size_bytes")
  hash      String?
  status    CommonStatus @default(active)
  metadata  Json?
  createdBy String?      @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  @@index([appId, tenantId])
  @@map("files")
}

model KnowledgeBase {
  id          String       @id @default(cuid())
  appId       String       @map("app_id")
  tenantId    String?      @map("tenant_id")
  name        String
  description String?
  visibility  String       @default("tenant")
  status      CommonStatus @default(active)
  config      Json?
  createdBy   String?      @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  @@index([appId, tenantId])
  @@map("knowledge_bases")
}

model KnowledgeFile {
  id              String     @id @default(cuid())
  appId           String     @map("app_id")
  tenantId        String?    @map("tenant_id")
  knowledgeBaseId String     @map("knowledge_base_id")
  fileId          String     @map("file_id")
  parseStatus     TaskStatus @default(pending) @map("parse_status")
  errorMessage    String?    @map("error_message")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@index([knowledgeBaseId])
  @@map("knowledge_files")
}

model KnowledgeChunk {
  id              String   @id @default(cuid())
  appId           String   @map("app_id")
  tenantId        String?  @map("tenant_id")
  knowledgeBaseId String   @map("knowledge_base_id")
  knowledgeFileId String?  @map("knowledge_file_id")
  chunkIndex      Int      @map("chunk_index")
  content         String
  embedding       Json?
  embeddingVector Unsupported("vector(384)")? @map("embedding_vector")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([knowledgeBaseId])
  @@map("knowledge_chunks")
}

model RagConfig {
  id              String       @id @default(cuid())
  appId           String       @map("app_id")
  tenantId        String?      @map("tenant_id")
  knowledgeBaseId String?      @map("knowledge_base_id")
  name            String
  topK            Int          @default(5) @map("top_k")
  scoreThreshold  Decimal?     @map("score_threshold") @db.Decimal(5, 4)
  status          CommonStatus @default(active)
  config          Json?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@map("rag_configs")
}

model RagQueryLog {
  id              String   @id @default(cuid())
  appId           String   @map("app_id")
  tenantId        String?  @map("tenant_id")
  userId          String?  @map("user_id")
  knowledgeBaseId String?  @map("knowledge_base_id")
  query           String
  matchedChunks   Json?    @map("matched_chunks")
  latencyMs       Int?     @map("latency_ms")
  costAmount      Decimal? @map("cost_amount") @db.Decimal(12, 6)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([appId, tenantId, createdAt])
  @@map("rag_query_logs")
}

model ApiKey {
  id         String       @id @default(cuid())
  appId      String       @map("app_id")
  tenantId   String?      @map("tenant_id")
  name       String
  keyHash    String       @map("key_hash")
  keyPrefix  String       @map("key_prefix")
  scopes     String[]
  expiresAt  DateTime?    @map("expires_at")
  lastUsedAt DateTime?    @map("last_used_at")
  status     CommonStatus @default(active)
  createdBy  String?      @map("created_by")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@index([appId, tenantId])
  @@map("api_keys")
}

model Webhook {
  id        String       @id @default(cuid())
  appId     String       @map("app_id")
  tenantId  String?      @map("tenant_id")
  name      String
  url       String
  secretRef String?      @map("secret_ref")
  events    String[]
  status    CommonStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@index([appId, tenantId])
  @@map("webhooks")
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  webhookId      String                @map("webhook_id")
  eventType      String                @map("event_type")
  payload        Json
  status         WebhookDeliveryStatus @default(pending)
  attemptCount   Int                   @default(0) @map("attempt_count")
  responseStatus Int?                  @map("response_status")
  responseBody   String?               @map("response_body")
  nextRetryAt    DateTime?             @map("next_retry_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  @@index([webhookId, status])
  @@map("webhook_deliveries")
}

model Task {
  id           String     @id @default(cuid())
  appId        String?    @map("app_id")
  tenantId     String?    @map("tenant_id")
  taskType     String     @map("task_type")
  status       TaskStatus @default(pending)
  payload      Json?
  result       Json?
  errorMessage String?    @map("error_message")
  startedAt    DateTime?  @map("started_at")
  finishedAt   DateTime?  @map("finished_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([appId, tenantId, status])
  @@map("tasks")
}

model Notification {
  id        String       @id @default(cuid())
  appId     String?      @map("app_id")
  tenantId  String?      @map("tenant_id")
  userId    String?      @map("user_id")
  title     String
  content   String?
  channel   String       @default("in_app")
  readAt    DateTime?    @map("read_at")
  status    CommonStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}

model Setting {
  id        String   @id @default(cuid())
  appId     String?  @map("app_id")
  tenantId  String?  @map("tenant_id")
  key       String
  value     Json
  scope     String   @default("system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([appId, tenantId, key])
  @@map("settings")
}

model AuditLog {
  id         String   @id @default(cuid())
  appId      String?  @map("app_id")
  tenantId   String?  @map("tenant_id")
  userId     String?  @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  ip         String?
  userAgent  String?  @map("user_agent")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([appId, tenantId, createdAt])
  @@map("audit_logs")
}

model DailyMetric {
  id         String   @id @default(cuid())
  appId      String?  @map("app_id")
  tenantId   String?  @map("tenant_id")
  metricKey  String   @map("metric_key")
  metricDate DateTime @map("metric_date")
  value      Decimal  @db.Decimal(18, 4)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([appId, tenantId, metricKey, metricDate])
  @@map("daily_metrics")
}

model Tag {
  id        String       @id @default(cuid())
  appId     String?      @map("app_id")
  tenantId  String?      @map("tenant_id")
  name      String
  color     String?
  status    CommonStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([appId, tenantId, name])
  @@map("tags")
}

model DictItem {
  id        String       @id @default(cuid())
  dictKey   String       @map("dict_key")
  itemKey   String       @map("item_key")
  label     String
  value     String
  sortOrder Int          @default(0) @map("sort_order")
  status    CommonStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@unique([dictKey, itemKey])
  @@map("dict_items")
}

model EventOutbox {
  id          String     @id @default(cuid())
  eventType   String     @map("event_type")
  aggregateId String?    @map("aggregate_id")
  payload     Json
  status      TaskStatus @default(pending)
  createdAt   DateTime   @default(now()) @map("created_at")
  processedAt DateTime?  @map("processed_at")

  @@index([status, createdAt])
  @@map("event_outbox")
}
