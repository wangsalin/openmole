{
  "name": "openmole",
  "version": "0.1.0-alpha.0",
  "private": false,
  "description": "Open-source backend foundation for multi-tenant AI SaaS platforms.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangsalin/openmole.git"
  },
  "bugs": {
    "url": "https://github.com/wangsalin/openmole/issues"
  },
  "homepage": "https://github.com/wangsalin/openmole#readme",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"prisma/**/*.ts\" \"scripts/**/*.js\"",
    "test:knowledge": "npm run build && node scripts/e2e-knowledge.js",
    "test:payment": "npm run build && node scripts/e2e-payment.js",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\" \"*.json\" \"*.md\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:ai": "tsx prisma/seed-ai-providers.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "admin:dev": "npm run dev -w apps/admin-web",
    "admin:build": "npm run build -w apps/admin-web",
    "admin:preview": "npm run preview -w apps/admin-web"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.3",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.5",
    "@prisma/client": "^6.14.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.80.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.11.1",
    "mammoth": "^1.12.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^2.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.33.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.28",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.33.0",
    "globals": "^17.7.0",
    "jszip": "^3.10.1",
    "prettier": "^3.9.5",
    "prisma": "^6.14.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.63.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
